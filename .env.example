# Файл .env необязателен. Без LLM запись и стенограмма работают, протокол — нет.
# Секреты (JWT, ключ шифрования, пароли базы) Docker создаёт сам в томе secrets.

# ── LLM — языковая модель ─────────────────────────────────────────────────────
# Проще — в личном кабинете (Профиль → Настройки ИИ); .env — запасной вариант, кабинет важнее.
# Любой провайдер с OpenAI-совместимым API (POST {LLM_BASE_URL}/chat/completions).
# LLM_BASE_URL: базовый адрес API БЕЗ /chat/completions на конце. Примеры:
#   https://api.deepseek.com
#   http://host.docker.internal:11434/v1   (локальная модель Ollama с хоста)
LLM_BASE_URL=""

# LLM_API_KEY: ключ провайдера. Для локальной модели без авторизации оставьте пустым.
LLM_API_KEY=""

# LLM_MODEL: имя модели у провайдера, например deepseek-chat
LLM_MODEL=""

# LLM_JSON_MODE: "false", если провайдер не поддерживает response_format
# {type: "json_object"}. По умолчанию режим включён.
LLM_JSON_MODE=""

# LLM_TIMEOUT_MS: таймаут запроса к модели, в миллисекундах. По умолчанию 60000.
LLM_TIMEOUT_MS=""

# ── Распознавание речи (сервис tone) ──────────────────────────────────────────
# HF_ENDPOINT: адрес зеркала HuggingFace, если huggingface.co недоступен из вашей сети.
# По умолчанию https://huggingface.co. Compose подставляет переменную в сервис tone сам;
# после изменения выполните: docker compose up -d
# HF_ENDPOINT="https://адрес-зеркала"

# DIARIZATION: разметка по голосу (кто говорит: врач, пациент, третий человек). По умолчанию "on".
# Выключатель — "off": тогда стенограмма без меток голоса, роли определяет модель по смыслу.
# Compose подставляет переменную в сервис tone сам; после изменения выполните: docker compose up -d
# DIARIZATION="off"

# DIARIZATION_THRESHOLD: порог различения голосов, только для отладки. Compose в контейнер
# её не передаёт: без своего override-файла она не действует. Менять не нужно:
# значение ниже равно умолчанию (1.0), другие — только для отладки.
# DIARIZATION_THRESHOLD="1.0"

# ── Вход ──────────────────────────────────────────────────────────────────────
# ENABLE_2FA: "true" — включить двухфакторную аутентификацию (код из приложения).
# По умолчанию выключена. Если аккаунт уже с 2FA, а флаг выключен, 2FA продолжает
# действовать: отключить можно в личном кабинете.
ENABLE_2FA=""

# ── Сервер ────────────────────────────────────────────────────────────────────
# APP_PORT: порт на хосте (приложение слушает только 127.0.0.1). По умолчанию 3000.
APP_PORT=""

# TRUST_PROXY: "true" ТОЛЬКО если приложение стоит за обратным прокси
# (nginx/Cloudflare), который очищает входящий X-Forwarded-For. По умолчанию
# false: лимиты запросов считаются по реальному IP сокета, и заголовок нельзя
# подделать, чтобы их обойти.
TRUST_PROXY=""

# PUBLIC_URL: адрес сайта для ссылки первого запуска, например https://med.example.com
# (без пути). Не задан — ссылка ведёт на localhost. Серверный установщик задаёт сам.
# PUBLIC_URL=""

# MEDSCRIBE_DOMAIN и ACME_EMAIL: домен и почта для сертификата Caddy. Нужны только в серверном
# режиме; их записывает установщик (install.sh с MEDSCRIBE_SERVER=1, его вызывает install-server.sh).
# MEDSCRIBE_DOMAIN=""
# ACME_EMAIL=""

# COMPOSE_FILE: какие compose-файлы подключены. Серверный режим ставит
# "docker-compose.yml:docker-compose.server.yml". Пока COMPOSE_FILE задан, файл
# docker-compose.override.yml Compose не подхватывает: добавьте его в список вручную.
# Меняйте, только если понимаете, что делаете.
# COMPOSE_FILE="docker-compose.yml:docker-compose.server.yml"

# ── Для опытных ───────────────────────────────────────────────────────────────
# JWT_SECRET: случайная строка для подписи токенов — минимум 32 символа.
# По умолчанию создаётся сама в томе secrets; задайте, только если переносите ключи.
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=""

# DATA_ENCRYPTION_KEY: отдельный ключ AES-256-GCM для шифрования медицинских
# данных (черновики EHR). ДОЛЖЕН отличаться от JWT_SECRET: утечка одного ключа
# не раскрывает другой, и их можно менять независимо.
# По умолчанию создаётся сам в томе secrets; задайте, только если переносите ключи.
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY=""

# ── Прежние ключи шифрования (ротация) ───────────────────────────────────────
# Ключ записей выводится из DATA_ENCRYPTION_KEY. Поэтому его смена делает уже
# сохранённые медицинские записи нечитаемыми. Перед ротацией положите ПРЕЖНЕЕ
# значение сюда — при неудаче с текущим ключом расшифровка пробует эти.
# Несколько — через запятую.
# DATA_ENCRYPTION_KEY_OLD=""

# ── Только для разработки без Docker ──────────────────────────────────────────
# TONE_SERVICE_URL=http://localhost:5001
# POSTGREST_URL=http://localhost:3001
# POSTGREST_JWT_SECRET=""

# GUIDELINES_USER_AGENT (для scripts/fetch-guidelines.mjs): User-Agent с контактом
# для запросов к внешнему сервису клинических рекомендаций.
# GUIDELINES_USER_AGENT=""
